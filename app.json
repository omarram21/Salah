{
  "expo": {
    "name": "Hayya",
    "slug": "salah",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salah",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.salah.prayertracker",
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.salah.prayertracker",
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hayya uses your location to calculate accurate prayer times."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C2410C",
          "sounds": [
            "./assets/sounds/oud.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/dawn.wav",
            "./assets/sounds/reminder.wav"
          ]
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "HayyaNext",
              "displayName": "Next prayer",
              "description": "Countdown to the next prayer",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "HayyaToday",
              "displayName": "Today",
              "description": "Today’s prayers and what you’ve marked",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular"
                ]
              }
            },
            {
              "name": "HayyaTimes",
              "displayName": "Prayer times",
              "description": "All five times for today",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ]
              }
            },
            {
              "name": "HayyaMark",
              "displayName": "Mark prayer",
              "description": "Mark the current prayer with one tap",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "HayyaStreak",
              "displayName": "Streak & week",
              "description": "Your streak and this week",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular"
                ]
              }
            },
            {
              "name": "HayyaArabic",
              "displayName": "حيّ",
              "description": "Next prayer in Arabic",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular"
                ]
              }
            },
            {
              "name": "HayyaSeason",
              "displayName": "Friday & Ramadan",
              "description": "Jumu’ah and Al-Kahf, or Suhoor and Iftar in Ramadan",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular"
                ]
              }
            },
            {
              "name": "HayyaMonth",
              "displayName": "Month",
              "description": "This month’s calendar",
              "ios": {
                "supportedFamilies": [
                  "systemLarge"
                ]
              }
            },
            {
              "name": "HayyaQibla",
              "displayName": "Qibla",
              "description": "Qibla direction from your city",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json"
    }
  }
}
