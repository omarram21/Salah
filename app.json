{
  "expo": {
    "name": "Hayya",
    "slug": "salah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salah",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.salah.prayertracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.salah.prayertracker"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hayya uses your location to calculate accurate prayer times."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C2410C",
          "sounds": [
            "./assets/sounds/oud.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/dawn.wav",
            "./assets/sounds/reminder.wav"
          ]
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json"
    }
  }
}
